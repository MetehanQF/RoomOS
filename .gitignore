# Secrets and local configuration
.env
.env.*
!.env.example

# Runtime auth state: device records, sessions, server secret.
# Generated on first run. Never commit any of it.
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
server-secret

# Your own device registry describes your home, not the project
config/*
!config/README.md

# Key material
*.pem
*.key
*.crt
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
build/
dist/

# Node / web build
node_modules/
web/dist/
*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
.vite/

# Editors
.idea/
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Runtime artifacts
*.log
