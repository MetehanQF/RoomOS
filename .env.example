# Copy to .env and fill in. Never commit the real file or token.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value has a safe default in compose.yaml; this file lists the ones you
# will normally set. See docs/configuration.md for the full list.

# Tag for the locally built images. Compose refuses to start without one, so a
# deployment always names the exact build it runs (scripts/build-release-images.sh
# produces immutable sha-<commit> tags).
ROOMOS_IMAGE_TAG=local

# --- Home Assistant -------------------------------------------------------------
HA_URL=http://homeassistant.local:8123
# A long-lived access token for a dedicated, non-admin Home Assistant user.
HA_TOKEN=
ROOMOS_HA_CONNECT_ENABLED=false

# Your installation registry (logical ID -> entity mapping). See config/README.md.
# Unset = the bundled example, which maps entities that do not exist.
ROOMOS_INSTALLATION_HOST_PATH=

# --- Control (read-only until you opt in) --------------------------------------
ROOMOS_CONTROL_ENABLED=false
ROOMOS_CONTROL_POLICY=read_only
ROOMOS_CONTROL_DEVICE_IDS=
ROOMOS_CONTROL_ACTIONS=

# --- Device authentication -----------------------------------------------------
ROOMOS_AUTH_ENABLED=true
# The exact origin/host your clients type. Cookies are Secure: use HTTPS.
ROOMOS_AUTH_ALLOWED_ORIGIN=https://roomos.example.com
ROOMOS_AUTH_ALLOWED_HOST=roomos.example.com

# --- Web front end -------------------------------------------------------------
# Loopback by default. Set to this host's LAN address to reach it from a tablet.
ROOMOS_BIND_ADDR=127.0.0.1
ROOMOS_HTTP_PORT=5500
# With compose.tls.yaml: a PEM pair from your own ACME client.
ROOMOS_TLS_CERT=
ROOMOS_TLS_KEY=

# --- Time ----------------------------------------------------------------------
# IANA zone of the installation: routines, push quiet hours, camera timestamps.
ROOMOS_ROUTINES_TIMEZONE=UTC
ROOMOS_PUSH_TIMEZONE=UTC

# --- DNS health (two resolvers you run) ----------------------------------------
ROOMOS_DNS_MONITOR_ENABLED=false
ROOMOS_DNS_PRIMARY_ADDRESS=192.0.2.53
ROOMOS_DNS_SECONDARY_ADDRESS=192.0.2.54

# --- Push notifications (optional) ---------------------------------------------
# legacy = fixed production notifications only; smart = alert-driven delivery.
ROOMOS_PUSH_MODE=legacy
ROOMOS_FCM_ENABLED=false
# Host paths to private credentials; keep them outside Git, mode 0600, Core-only.
ROOMOS_FCM_CREDENTIALS_HOST_PATH=
ROOMOS_WEBPUSH_VAPID_HOST_PATH=
ROOMOS_WEBPUSH_VAPID_SUBJECT=https://roomos.example.com

# --- Windows workstation telemetry (optional, HASS.Agent) ----------------------
# The agent device name, and a JSON map of RoomOS sensor ids to the HA entity ids
# HASS.Agent created ("heartbeat" is required). Empty = not configured.
ROOMOS_DEVICES_WORKSTATION_AGENT_ID=
ROOMOS_DEVICES_WORKSTATION_ENTITIES=

# --- Backup status (optional) --------------------------------------------------
# Directory scripts/roomos-backup-run.sh writes status.json into.
ROOMOS_BACKUP_STATUS_HOST_DIR=
