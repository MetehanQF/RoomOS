# Copy to .env and fill in your own values. Never commit .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# RoomOS ships locked down: authentication is on, control is off, and the
# bundled device registry points at entities that do not exist. Widen one thing
# at a time and confirm each step.

# --- Home Assistant -----------------------------------------------------------
# Base URL of your Home Assistant instance, reachable from the Core container.
HA_URL=http://homeassistant.local:8123

# Long-lived access token for a DEDICATED Home Assistant user.
# HA profile -> Security -> Long-lived access tokens.
# This value never leaves Core: it is not sent to any client.
HA_TOKEN=

# --- Device registry ----------------------------------------------------------
# Absolute path to your registry. Leave empty to use the bundled example, which
# maps placeholder entities and therefore controls nothing.
#   cp core/app/devices.example.yaml config/devices.yaml
# See docs/configuration.md for the schema.
ROOMOS_DEVICE_REGISTRY=

# --- Exposure -----------------------------------------------------------------
# Host address Compose publishes the web UI on. Loopback by default.
# Set to this host's LAN address to reach RoomOS from a tablet.
# Never use 0.0.0.0.
ROOMOS_BIND_ADDR=127.0.0.1
ROOMOS_HTTP_PORT=5500

# --- Authentication -----------------------------------------------------------
# Leave enabled. Disabling it removes every device check and is intended only
# for local development against fake data.
ROOMOS_AUTH_ENABLED=true

# The EXACT origin and host RoomOS accepts authenticated requests from.
# Both must match what your clients actually type, or every request is refused.
# Session cookies are Secure, so this must be https:// in any real deployment.
ROOMOS_AUTH_ALLOWED_ORIGIN=https://roomos.example.com
ROOMOS_AUTH_ALLOWED_HOST=roomos.example.com

# Session lifetimes. Sliding renews on use; absolute is the hard ceiling.
ROOMOS_AUTH_SESSION_SLIDING_DAYS=30
ROOMOS_AUTH_SESSION_ABSOLUTE_DAYS=180

# Pairing window: how long a code is valid, and how many attempts are allowed
# within the rate-limit window. Codes are single-use.
ROOMOS_AUTH_PAIRING_TTL_SECONDS=600
ROOMOS_AUTH_PAIRING_ATTEMPTS=5
ROOMOS_AUTH_PAIRING_WINDOW_SECONDS=300

# Where device records and the server secret live. Inside Compose this is a
# named volume; for a local run outside Docker, data/ is git-ignored.
# ROOMOS_AUTH_DATABASE_PATH=data/roomos-auth.db
# ROOMOS_AUTH_SECRET_PATH=data/server-secret

# --- Optional TLS overlay (compose.tls.yaml) ----------------------------------
# Absolute paths to your own PEM pair. RoomOS does not issue certificates.
ROOMOS_TLS_CERT=
ROOMOS_TLS_KEY=
ROOMOS_HTTPS_PORT=8443

# --- Runtime ------------------------------------------------------------------
ROOMOS_LOG_LEVEL=INFO

# Open the live Home Assistant REST/WebSocket connection. Reads only.
ROOMOS_HA_CONNECT_ENABLED=false

# Global kill switch. While false, every write route returns 403 regardless of
# the policy below.
ROOMOS_CONTROL_ENABLED=false

# read_only | scoped | production
#   read_only  - nothing is writable (default)
#   scoped     - only ROOMOS_CONTROL_DEVICE_IDS x ROOMOS_CONTROL_ACTIONS
#   production - every registered device; the group stays power-only
ROOMOS_CONTROL_POLICY=read_only

# Comma-separated, used by the scoped policy only.
ROOMOS_CONTROL_DEVICE_IDS=
ROOMOS_CONTROL_ACTIONS=

# WebSocket reconnect backoff bounds, in seconds.
ROOMOS_HA_RECONNECT_MIN_SECONDS=1
ROOMOS_HA_RECONNECT_MAX_SECONDS=60
